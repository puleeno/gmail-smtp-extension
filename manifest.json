{
    "name": "Gmail SMTP",
    "version": "1.0.0",
    "description": "Gửi email WordPress qua Gmail SMTP (App Password) thay cho hàm mail() mặc định của hosting.",
    "author": "Jankx",
    "extension_id": "gmail-smtp",
    "context": ["always"],
    "caller": {
        "file": "GmailSmtpExtension.php",
        "class": "Jankx\\Extensions\\GmailSmtp\\GmailSmtpExtension",
        "method": "init"
    },
    "requirements": {
        "php": ">=7.4"
    },
    "auto_activate": true,
    "settings_url": "admin.php?page=jankx-gmail-smtp"
}